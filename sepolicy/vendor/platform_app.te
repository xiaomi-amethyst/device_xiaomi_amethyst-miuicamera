hal_client_domain(platform_app, vendor_hal_camerapostproc_xiaomi)
hal_client_domain(platform_app_36, vendor_hal_camerapostproc_xiaomi)

binder_use(platform_app)
binder_use(platform_app_36)
binder_call(platform_app, hal_camera_default)
binder_call(platform_app_36, hal_camera_default)
binder_call(platform_app, vendor_hal_camerapostproc_xiaomi)
binder_call(platform_app_36, vendor_hal_camerapostproc_xiaomi)
allow platform_app vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;
allow platform_app_36 vendor_hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;
allow platform_app hal_aidlbgservice_service:service_manager find;
allow platform_app_36 hal_aidlbgservice_service:service_manager find;
allow platform_app vendor_misys_service:service_manager find;
allow platform_app_36 vendor_misys_service:service_manager find;

allow platform_app proc_pressure_cpu:file r_file_perms;
allow platform_app_36 proc_pressure_cpu:file r_file_perms;
allow platform_app proc_pressure_mem:file r_file_perms;
allow platform_app_36 proc_pressure_mem:file r_file_perms;
allow platform_app proc_pressure_io:file r_file_perms;
allow platform_app_36 proc_pressure_io:file r_file_perms;

allow platform_app adsprpcd_file:dir { open read search };
allow platform_app_36 adsprpcd_file:dir { open read search };

allow platform_app vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app_36 vendor_camera_data_file:dir { append map r_dir_perms write };
allow platform_app vendor_camera_data_file:file { getattr open read };
allow platform_app_36 vendor_camera_data_file:file { getattr open read };

allow platform_app same_process_hal_file:file { execute getattr open read map };
allow platform_app_36 same_process_hal_file:file { execute getattr open read map };

allow platform_app app_data_file:file execute;
allow platform_app_36 app_data_file:file execute;

# Properties
get_prop(platform_app, vendor_audio_prop)
get_prop(platform_app_36, vendor_audio_prop)
get_prop(platform_app, vendor_camera_p3enable_prop)
get_prop(platform_app_36, vendor_camera_p3enable_prop)
get_prop(platform_app, vendor_camera_prop)
get_prop(platform_app_36, vendor_camera_prop)
get_prop(platform_app, vendor_camera_sensor_prop)
get_prop(platform_app_36, vendor_camera_sensor_prop)
get_prop(platform_app, vendor_display_prop)
get_prop(platform_app_36, vendor_display_prop)
get_prop(platform_app, vendor_displayfeature_prop)
get_prop(platform_app_36, vendor_displayfeature_prop)
get_prop(platform_app, vendor_panel_info_prop)
get_prop(platform_app_36, vendor_panel_info_prop)
get_prop(platform_app, vendor_persist_camera_prop)
get_prop(platform_app_36, vendor_persist_camera_prop)
