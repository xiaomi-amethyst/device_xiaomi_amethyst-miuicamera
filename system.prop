# Google Lens
ro.com.google.lens.oem_camera_package=com.android.camera

# Framework allowlists
persist.vendor.camera.privapp.list=com.android.camera,org.lineageos.aperture

# MiuiCamera
ro.miui.notch=1
ro.miui.ui.version.name=V816
ro.miui.ui.version.code=816
ro.product.camera.livephoto.support=3
vendor.camera.aux.packagelist=com.android.camera,org.lineageos.aperture,com.google.android.GoogleCamera
vendor.camera.support.mivi=true